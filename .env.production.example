# Production Environment Variables
# Copy this file to .env.production and fill in your real values.

NODE_ENV=production
PORT=3000

# Security Secrets (Generate strong random strings for these)
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_super_secret_session_key_here

# Database Configuration (Used by MySQL container)
MYSQL_ROOT_PASSWORD=strong_root_password
MYSQL_DATABASE=maestro_cerca
MYSQL_USER=maestro_app
MYSQL_PASSWORD=strong_app_password

# Database URL for Node app (Connects to the db container)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://maestro_app:strong_app_password@db:3306/maestro_cerca

# Cloudflare R2 / AWS S3 Configuration (For avatar and gallery uploads)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=maestro-cerca-assets
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
